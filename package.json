{
  "name": "@leskasoft/tt2-skill-optimizer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Free open-source Tap Titans 2 skill tree optimizer (TT2 8.4)",
  "scripts": {
    "test": "node --test tests/*.test.js",
    "check": "npm test && npm run check:data && npm run check:modules",
    "check:data": "node scripts/verify-data.mjs",
    "bench:22k": "node scripts/benchmark-22k.mjs --all",
    "bench:issue30": "node scripts/benchmark-22k.mjs --all --sp 22600 && node scripts/benchmark-22k.mjs --all --sp 50000",
    "check:modules": "node scripts/verify-module-graph.mjs",
    "bench:push": "node scripts/benchmark-22k.mjs --all --sp 22600 --push-source-skip",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1"
  }
}
